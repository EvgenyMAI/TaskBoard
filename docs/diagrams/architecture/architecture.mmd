%% TaskBoard — логическая архитектура. Генерация: docs/scripts/generate-architecture.ps1

flowchart TB

    CLIENT(["Клиент<br/>Веб-интерфейс (React, Vite)"])

    subgraph SVC["Сервисы приложения (Spring Boot 3, Java 17)"]
        direction LR
        AUTH["auth-service<br/>Учёт пользователей<br/>Регистрация, вход, роли<br/>Выдача JWT"]
        TASKS["tasks-service<br/>Проекты и задачи<br/>Комментарии, вложения, история<br/>Проверка JWT (taskboard-common)"]
        ANALYTICS["analytics-service<br/>Уведомления и отчёты<br/>Поток SSE в браузер<br/>Проверка JWT (taskboard-common)"]
    end

    subgraph DATA["Слой данных"]
        direction LR
        DBA[("PostgreSQL<br/>taskboard_auth")]
        subgraph DATA_TASKS[" "]
            direction TB
            DBT[("PostgreSQL<br/>taskboard_tasks")]
            MINIO[("MinIO<br/>файлы вложений")]
        end
        DBN[("PostgreSQL<br/>taskboard_analytics")]
    end

    CLIENT -->|"HTTP, JSON"| AUTH
    CLIENT -->|"HTTP, JSON"| TASKS
    CLIENT -->|"HTTP, JSON"| ANALYTICS

    AUTH --> DBA
    TASKS --> DBT
    TASKS --> MINIO
    ANALYTICS --> DBN

    TASKS -->|"уведомления<br/>REST, внутр. ключ"| ANALYTICS
    ANALYTICS -->|"данные для отчётов"| TASKS
    ANALYTICS -->|"список пользователей"| AUTH

    classDef client fill:#D5E8D4,stroke:#82B366,stroke-width:2px,color:#1a1a1a
    classDef service fill:#E1D5E7,stroke:#9673A6,stroke-width:2px,color:#1a1a1a
    classDef db fill:#FFF2CC,stroke:#D6B656,stroke-width:2px,color:#1a1a1a

    class CLIENT client
    class AUTH,TASKS,ANALYTICS service
    class DBA,DBT,DBN,MINIO db
